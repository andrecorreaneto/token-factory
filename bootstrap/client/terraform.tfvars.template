identity_domain_url    = "https://replace-with-domain.identity.oraclecloud.com:443"
identity_domain_region = "us-chicago-1"
resource_name_prefix   = "token-factory"

enable_oci_secrets                     = true
oci_secrets_compartment_ocid           = "ocid1.compartment.oc1..replace-with-secrets-compartment-ocid"

